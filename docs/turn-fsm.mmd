%% FSM del turno (SPEC.md §3.4, ADR 0004).
%% En el engine cada estado es una variante de `state.phase.kind` y cada flecha
%% es una entrada de la tabla de transiciones que valida `reduce`.
%% Las fases interrumpibles (AUCTION_OPEN, IN_DEBT, TRADE_OPEN) guardan
%% `returnTo`: la fase a la que se vuelve cuando se cierran.
stateDiagram-v2
    [*] --> TURN_ORDER: START_GAME
    TURN_ORDER --> WAITING_ROLL: orden definido

    state "Inicio de turno" as start {
        WAITING_ROLL
        JAIL_DECISION
    }

    WAITING_ROLL --> ROLLING: ROLL_DICE
    JAIL_DECISION --> WAITING_ROLL: PAY_JAIL_FINE / USE_JAIL_CARD
    JAIL_DECISION --> ROLLING: ROLL_FOR_DOUBLES

    ROLLING --> MOVING: tirada válida
    ROLLING --> JAIL: tercer doble seguido
    ROLLING --> END_TURN: preso sin dobles (turno 1 o 2)

    MOVING --> RESOLVING_TILE: llega a la casilla (cobra Salida si pasa)

    state resolve <<choice>>
    RESOLVING_TILE --> resolve
    resolve --> DECISION_BUY: propiedad sin dueño
    resolve --> PAY_RENT: propiedad ajena no hipotecada
    resolve --> DRAW_CARD: Suerte / Barrio
    resolve --> TAX: impuesto
    resolve --> JAIL: Vas preso
    resolve --> POST_ACTION: propia, hipotecada, esquina neutra

    DECISION_BUY --> POST_ACTION: BUY_PROPERTY
    DECISION_BUY --> AUCTION_OPEN: DECLINE_PURCHASE
    PAY_RENT --> POST_ACTION: pagado
    TAX --> POST_ACTION: pagado
    DRAW_CARD --> MOVING: carta de movimiento
    DRAW_CARD --> JAIL: carta Vas preso
    DRAW_CARD --> POST_ACTION: resto de cartas

    JAIL --> END_TURN: termina el turno aunque haya dobles

    POST_ACTION --> WAITING_ROLL: sacó dobles (y < 3)
    POST_ACTION --> END_TURN: END_TURN

    END_TURN --> WAITING_ROLL: siguiente jugador libre
    END_TURN --> JAIL_DECISION: siguiente jugador preso
    END_TURN --> GAME_OVER: queda un solo jugador / se acabó el tiempo

    %% Transversales: se abren desde una fase y vuelven a `returnTo`.
    AUCTION_OPEN --> POST_ACTION: martillazo (returnTo)
    PAY_RENT --> IN_DEBT: no alcanza el efectivo
    TAX --> IN_DEBT: no alcanza el efectivo
    DRAW_CARD --> IN_DEBT: no alcanza el efectivo
    IN_DEBT --> POST_ACTION: juntó la plata (returnTo)
    IN_DEBT --> BANKRUPT: DECLARE_BANKRUPTCY
    BANKRUPT --> AUCTION_OPEN: quiebra ante el banco (subasta una por una)
    BANKRUPT --> END_TURN: quiebra ante un jugador
    POST_ACTION --> TRADE_OPEN: PROPOSE_TRADE
    TRADE_OPEN --> POST_ACTION: aceptado / rechazado / vencido (returnTo)

    GAME_OVER --> [*]

    note right of IN_DEBT
        También puede abrir TRADE_OPEN
        para vender propiedades.
    end note
    note left of WAITING_ROLL
        PAUSED_DISCONNECT es del server:
        congela el timer, no cambia la fase.
    end note
