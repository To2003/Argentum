# Variables de entorno de El Gran Negocio. Es la referencia de TODAS las que
# existen; en desarrollo ninguna hace falta (cada una tiene un default que anda
# en local). Guía de deploy paso a paso: docs/deploy.md.
#
# Dónde se definen:
#   - Server: el server NO lee archivos .env. En local, en la terminal
#     (PowerShell: `$env:WEB_ORIGIN="..."`); en producción, fly.toml → [env].
#   - Web: Vite lee apps/web/.env.local (copiá ahí las VITE_*); en producción,
#     Vercel → Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Server de juego (apps/server) — en producción van en fly.toml → [env]
# ---------------------------------------------------------------------------

# `production` apaga las rutas /dev/* (escenarios de prueba). El Dockerfile y
# fly.toml ya lo fijan; en desarrollo dejalo sin definir.
# NODE_ENV=production

# Puerto donde escucha el server. Fly.io: tiene que coincidir con
# `internal_port` de fly.toml.
PORT=3001

# Orígenes de la web habilitados por CORS (socket y HTTP), separados por coma,
# sin barra final. Si no coincide EXACTO con la URL de la web, el navegador no
# se puede conectar.
#   Desarrollo: http://localhost:5173
#   Producción: https://gran-negocio.vercel.app
WEB_ORIGIN=http://localhost:5173

# Base SQLite con las partidas (seed + acciones); la carpeta se crea sola.
# Producción (Fly.io): /data/gran-negocio.db, dentro del volumen montado.
DB_PATH=./data/gran-negocio.db

# Default de la regla por sala `useRealBrands` (SPEC.md §15.2).
# false = Edenor y AySA con nombres genéricos.
USE_REAL_BRANDS=true

# Pausa (ms) entre jugadas de los bots, para que se puedan seguir.
# Los e2e la bajan a 40.
BOT_DELAY_MS=900

# ---------------------------------------------------------------------------
# Web (apps/web) — Vite solo expone variables con prefijo VITE_, y las fija
# al BUILDEAR: en Vercel van en Settings → Environment Variables y hay que
# volver a desplegar después de cambiarlas.
# ---------------------------------------------------------------------------

# URL del server de juego. Sin definir: el mismo host de la página en el
# puerto 3001 (sirve en desarrollo y en la red local).
#   Producción: https://gran-negocio-server.fly.dev
VITE_SERVER_URL=http://localhost:3001
