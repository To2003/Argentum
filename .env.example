# Server de juego (apps/server)
PORT=3001
# Orígenes del front habilitados por CORS, separados por coma.
WEB_ORIGIN=http://localhost:5173
# Base SQLite con las partidas (seed + acciones); se crea sola.
DB_PATH=./data/gran-negocio.db

# Web (apps/web) — Vite solo expone variables con prefijo VITE_
VITE_SERVER_URL=http://localhost:3001

# Default de la regla por sala useRealBrands (SPEC.md §15.2). false = Edenor y AySA genéricos.
USE_REAL_BRANDS=true
